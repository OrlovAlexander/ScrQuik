<Window x:Class="WatchNetUi.AddInstrumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить инструмент"
        Height="640" Width="980"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#FF16181D"
        Foreground="#FFE8EAED"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF9AA3AF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="DarkField" TargetType="TextBox">
      <Setter Property="Background" Value="#FF0F1115"/>
      <Setter Property="Foreground" Value="#FFF1F3F5"/>
      <Setter Property="BorderBrush" Value="#FF3A4250"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="#FFE8EAED"/>
      <Setter Property="SelectionBrush" Value="#FF3A6EA5"/>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Background" Value="#FF242830"/>
      <Setter Property="Foreground" Value="#FFC5CCD6"/>
      <Setter Property="BorderBrush" Value="#FF3A4250"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF2A4A6E"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5B8FC7"/>
                <Setter Property="Foreground" Value="#FFF5F7FA"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5B8FC7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Background" Value="#FF242830"/>
      <Setter Property="Foreground" Value="#FFE8EAED"/>
      <Setter Property="BorderBrush" Value="#FF3A4250"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF2E3440"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#FF2F6FED"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FF2F6FED"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF3B7CFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFE8EAED"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="AlternatingRowBackground" Value="#FF141820"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#FF2A3038"/>
      <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="CanUserSortColumns" Value="True"/>
      <Setter Property="CanUserReorderColumns" Value="False"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="EnableColumnVirtualization" Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FF1E2430"/>
      <Setter Property="Foreground" Value="#FF9AA3AF"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#FF2A3038"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF2A4A6E"/>
          <Setter Property="Foreground" Value="#FFF5F7FA"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FF1E2430"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF2A4A6E"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Класс" Style="{StaticResource FieldLabel}"/>
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="ChipTqbr" Content="TQBR" Style="{StaticResource Chip}"
                      Checked="ClassChip_Checked" Unchecked="ClassChip_Unchecked"/>
        <ToggleButton x:Name="ChipSpbfut" Content="SPBFUT" Style="{StaticResource Chip}"
                      Checked="ClassChip_Checked" Unchecked="ClassChip_Unchecked"/>
        <ToggleButton x:Name="ChipCrypto" Content="Крипта" Style="{StaticResource Chip}"
                      ToolTip="BTC / ETH / USDT и похожие (в т.ч. фьючерсы SPBFUT)"
                      Checked="ClassChip_Checked" Unchecked="ClassChip_Unchecked"/>
        <ComboBox x:Name="CmbOtherClass" Width="140" Margin="4,0,0,0" Padding="8,4"
                  Background="#FF0F1115" Foreground="#FFE8EAED" BorderBrush="#FF3A4250"
                  IsEditable="False" Visibility="Collapsed"
                  SelectionChanged="CmbOtherClass_SelectionChanged"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="Поиск" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="TxtSearch" Style="{StaticResource DarkField}"
               TextChanged="TxtSearch_TextChanged"/>
    </StackPanel>

    <DockPanel Grid.Row="2" Margin="0,0,0,6">
      <TextBlock x:Name="TxtCount" DockPanel.Dock="Right" Foreground="#FF6B7380" FontSize="12"
                 VerticalAlignment="Center"/>
      <TextBlock Text="Инструменты · клик по заголовку — сортировка" Style="{StaticResource FieldLabel}" Margin="0"/>
    </DockPanel>

    <Border Grid.Row="3" Background="#FF0F1115" BorderBrush="#FF3A4250" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True">
      <DataGrid x:Name="GridSec" Style="{StaticResource SecGrid}"
                MouseDoubleClick="GridSec_MouseDoubleClick"
                PreviewKeyDown="GridSec_PreviewKeyDown">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Код" Binding="{Binding Sec}" SortMemberPath="Sec"
                              Width="88" FontFamily="Consolas" FontWeight="SemiBold"/>
          <DataGridTextColumn Header="Название" Binding="{Binding Name}" SortMemberPath="Name"
                              Width="*" MinWidth="160"/>
          <DataGridTextColumn Header="Цена" Binding="{Binding LastText}" SortMemberPath="Last"
                              Width="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontFamily" Value="Consolas"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Шаг" Binding="{Binding PriceStepText}" SortMemberPath="PriceStep"
                              Width="72">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="#FF9AA3AF"/>
                <Setter Property="FontFamily" Value="Consolas"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Оборот" Binding="{Binding ValTodayText}" SortMemberPath="ValToday"
                              Width="110">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontFamily" Value="Consolas"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Объём" Binding="{Binding VolTodayText}" SortMemberPath="VolToday"
                              Width="88">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="#FF9AA3AF"/>
                <Setter Property="FontFamily" Value="Consolas"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Экспирация" Binding="{Binding ExpiryText}" SortMemberPath="ExpirySort"
                              Width="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFB0B8C4"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="12"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <StackPanel Grid.Row="4" Margin="0,12,0,0">
      <TextBlock x:Name="TxtDumpStatus" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                 Foreground="#FF6B9BD1" Margin="0,0,0,6"/>
      <TextBlock TextWrapping="Wrap" Foreground="#FF6B7380" FontSize="11"
                 Text="Оборот/цена — снимок SecDump (раз в 5 мин). CNY→CRZ6, Si→SiZ6. После + перезапустите barsSaver."/>
    </StackPanel>

    <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="Обновить dump" Style="{StaticResource GhostBtn}"
              Click="BtnReloadDump_Click"/>
      <Button DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource PrimaryBtn}"
              MinWidth="110" IsDefault="True" Click="BtnOk_Click" Margin="8,0,0,0"/>
      <Button DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource GhostBtn}"
              MinWidth="90" IsCancel="True" Click="BtnCancel_Click"/>
    </DockPanel>
  </Grid>
</Window>
